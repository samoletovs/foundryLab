# Shared Foundry / Azure config for foundryLab agents
# Copy this file to .env and fill in values

# --- Azure subscription ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=foundrylab-rg
AZURE_LOCATION=northeurope

# --- Foundry project ---
# Endpoint of the shared Foundry project that hosts all foundryLab agents
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_PROJECT_NAME=foundrylab

# --- Default model deployment ---
# Created inside the Foundry project; reused by all agents unless overridden
FOUNDRY_DEFAULT_MODEL=gpt-4o-mini
FOUNDRY_DEFAULT_DEPLOYMENT=gpt-4o-mini

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Optional: per-agent overrides go in agents/<name>/.env ---
